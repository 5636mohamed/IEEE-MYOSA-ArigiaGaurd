solid sensor_pod_enclosure_top
  // HARDWARE IMPLEMENTATION NOTICE:
  // This part represents the physical 3D top enclosure shell for the ArigiaGaurd sacral sensor pod.
  // Physical manufacturing is required on an FDM/SLA 3D printer (Biocompatible PETG/ABS).
  // This hardware component cannot be simulated in software.
  facet normal 0.000000e+00 0.000000e+00 1.000000e+00
    outer loop
      vertex 0.000000e+00 0.000000e+00 1.800000e+01
      vertex 6.500000e+01 0.000000e+00 1.800000e+01
      vertex 6.500000e+01 4.500000e+01 1.800000e+01
    endloop
  endfacet
  facet normal 0.000000e+00 0.000000e+00 1.000000e+00
    outer loop
      vertex 0.000000e+00 0.000000e+00 1.800000e+01
      vertex 6.500000e+01 4.500000e+01 1.800000e+01
      vertex 0.000000e+00 4.500000e+01 1.800000e+01
    endloop
  endfacet
endsolid sensor_pod_enclosure_top
